# --- Database (Supabase Postgres) ---
# Prisma uses the `pg` adapter (a direct connection pool), so prefer the SESSION
# pooler / direct connection on port 5432. The transaction pooler (port 6543 with
# pgbouncer=true) can break prepared statements used by the adapter.
DATABASE_URL=postgresql://postgres.<project-ref>:YOUR_PASSWORD@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# --- Auth (REQUIRED) ---
# The app throws on boot if JWT_SECRET is missing. Generate a strong value, e.g.:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
# Only required if you keep the legacy access-code gate (/api/auth/verify).
VEV_ACCESS_CODE=replace-or-remove

# --- Integrations ---
OPENAI_API_KEY=sk-...
FIRECRAWL_API_KEY=fc-...

# --- App ---
NEXT_PUBLIC_APP_NAME=Viral Engine Views
# Used by PM2 / next start on the VPS
PORT=3001
HOSTNAME=0.0.0.0
